# Variáveis públicas do frontend. Copie Project URL e Publishable key do Supabase.
VITE_SUPABASE_URL=https://seu-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua-chave-publica

# Chave usada somente pelo servidor. Nunca use VITE_ neste nome.
